{
  "name": "lan-agent-chat",
  "productName": "LAN Chat",
  "version": "0.2.0",
  "description": "같은 네트워크(LAN)에서 접속하는 VS Code 스타일 에이전트 CLI 채팅",
  "main": "app/main.js",
  "bin": { "lan-chat": "cli.js" },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "cli": "node cli.js",
    "dist": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.jihun.lanchat",
    "files": [
      "app/**",
      "public/**",
      "server.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
