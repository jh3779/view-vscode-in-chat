{
  "name": "lan-agent-chat",
  "productName": "LAN Chat",
  "version": "0.3.0",
  "description": "같은 네트워크(LAN)에서 쓰는 VS Code 스타일 채팅 — 일반 대화창과 개인 AI CLI 대화창 분리",
  "main": "app/main.js",
  "bin": {
    "lan-chat": "cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "cli": "node cli.js",
    "dist": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.jihun.lanchat",
    "files": [
      "app/**",
      "public/**",
      "server.js",
      "agent.js",
      "cli.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jh3779/view-vscode-in-chat.git"
  },
  "bugs": {
    "url": "https://github.com/jh3779/view-vscode-in-chat/issues"
  },
  "homepage": "https://github.com/jh3779/view-vscode-in-chat#readme",
  "keywords": [
    "lan",
    "chat",
    "sse",
    "electron",
    "claude",
    "cli",
    "offline"
  ]
}
